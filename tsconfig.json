{
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build", "**/*.test.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "noEmit": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    "strict": true,

    "types": ["node", "vite/client"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}